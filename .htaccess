# O funil chama /api/createPixPayment (sem extensão), como fazia no server.js.
# Aqui mapeamos esses caminhos para os arquivos .php equivalentes, para não
# precisar alterar os HTMLs do checkout.
<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{DOCUMENT_ROOT}/api/$1.php -f
    RewriteRule ^api/([A-Za-z0-9_-]+)/?$ api/$1.php [L,QSA]
</IfModule>

# Dados de pagamento e credenciais nunca podem ser baixados pelo navegador.
<FilesMatch "(^\.env|^\.env\..*|pix_payments\.json|package-lock\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# server.js e afins não devem ser servidos como texto.
<FilesMatch "\.(js\.map|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>
