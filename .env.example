# Copie para .env e preencha. O .env NÃO vai para o git.
# Nenhuma credencial deve ficar escrita no código.

# Porta do servidor (a Hostinger injeta esta variável sozinha)
PORT=8080

# Chave da API Skale Payments
# Painel: https://dashboard.skalepayments.com.br  ->  Configurações -> API Keys
SKALE_API_KEY=

# Token da API de consulta de CPF (magmadatahub)
CPF_API_TOKEN=

# Confirmação manual de pagamento (APENAS para testes locais).
# DEIXE VAZIO EM PRODUÇÃO — senão qualquer pessoa avança sem pagar.
ALLOW_MANUAL_PIX_CONFIRM=
