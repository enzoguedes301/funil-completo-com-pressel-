# Porta do servidor (Hostinger injeta automaticamente)
PORT=8080

# Chave da API Skale Payments (produção)
# Obtenha em: https://dashboard.skalepayments.com.br
SKALE_API_KEY=sk_seu_token_aqui

# URL pública que a Skale faz callback quando PIX é confirmado
# HTTPS obrigatório e deve ser acessível pela internet
SKALE_WEBHOOK_URL=https://seu-dominio.com/api/pixWebhook

# Confirmação manual de pagamento (APENAS para testes locais)
# DEIXE VAZIO OU REMOVIDO EM PRODUÇÃO
# ALLOW_MANUAL_PIX_CONFIRM=1
